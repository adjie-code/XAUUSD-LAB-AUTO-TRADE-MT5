# Dashboard
DASHBOARD_PORT=8090

# Admin dashboard (bukan akun MT5). Buat password kuat.
XAUUSD_DASH_USER=admin
XAUUSD_DASH_PASS=ganti-password-ini

# Simbol awal chart MT5. Jika broker memakai suffix, isi simbol aslinya:
# XAUUSDc, XAUUSDb, XAUUSDm, XAUUSD., GOLD, dll.
# EA juga punya auto-detect XAUUSD/GOLD saat simbol awal tidak ada.
MT5_SYMBOL=XAUUSD

# Port noVNC MT5 (opsional untuk melihat terminal)
MT5_NOVNC_PORT=17080

# Installer MT5 generik; bisa diganti installer broker bila perlu.
MT5_INSTALLER_URL=https://download.mql5.com/cdn/web/metaquotes.software.corp/mt5/mt5setup.exe
